# ============================================================================
# AI 数字员工 系统配置模板
# ============================================================================
# 复制此文件为 cfg.yml 并根据实际环境修改:
#   cp cfg.yml.template cfg.yml
#
# 配置优先级: 环境变量 > cfg.yml > 默认值
#
# ⚠ 业务配置（接口地址、密钥等）请通过管理后台「模板管理」页面
#   上传 CSV 配置，不要写在 cfg.yml 中。
# ============================================================================

# ---- 服务配置 ----
server:
  # HTTP/HTTPS 监听端口
  port: 20001

  # 调试模式: true=开启(日志更详细), false=关闭(生产环境)
  debug: false

  # 容器对外服务地址（用于管理后台获取服务器信息及 CLAUDE.md 模板渲染）
  self_ip: 192.168.1.102

# ---- 系统配置 ----
sys:
  # Worker 数量 = 同时调用 Agent SDK 的任务数上限
  max_concurrent_tasks: 5

  # 任务总数上限 (pending + processing)，超过后拒单返回 code=2002
  max_pending_tasks: 10

  # 运行时数据保留天数（task_logs + sdk_traces + sessions 自动清理）
  retention_days: 180

  # 日志按天滚动 + gzip 压缩保留数量
  log_rolled_count: 30     # 滚动 .log 文件保留数量（不含 .gz）
  log_gz_count: 60         # 压缩 .log.gz 文件保留数量

# ---- LLM 适配器配置（必填，指向 Anthropic 协议兼容网关） ----
# 本服务通过网关调用 LLM，base_url 留空则启动时报错退出。
llm:
  # 网关地址【必填】
  base_url: "http://api-gate:16001"

  # 网关认证 token（对应网关的 llm_api_key；网关未启用认证可留空）
  auth_token: "sk-12345"

  # 各模型映射（由网关转发到真实模型）
  model: "deepseek-v4-pro[1m]"
  opus_model: "deepseek-v4-pro[1m]"
  sonnet_model: "deepseek-v4-pro[1m]"
  haiku_model: "deepseek-v4-flash[1m]"
  subagent_model: "deepseek-v4-flash[1m]"

  # 推理强度: low | medium | high | xhigh | max
  effort_level: "max"

  # API 超时（毫秒），单任务最长执行时间
  timeout_ms: 300000

  # 单任务最大 agentic turns（API 往返次数），防无限循环
  max_turns: 200

  # 离线/私有部署优化：关闭非必要遥测
  disable_nonessential_traffic: true
  # 关闭 Co-Authored-By 归因头
  attribution_header: false
  # 禁用自动模式服务器（CLAUDE_CODE_AUTO_MODE_SERVER=0）
  # 解决私有部署环境下 classifier unavailable 的问题，通常保持 false
  auto_mode_server: false

# ---- Runner 集群配置 ----
runner:
  # 控制面 ↔ runner 认证 token，从环境变量 RUNNER_TOKEN 读取，不写死
  # token: "${RUNNER_TOKEN}"

  # runner 监听端口
  port: 21001

  # 心跳间隔（毫秒）
  heartbeat_ms: 5000

  # 连接超时（毫秒）
  connect_timeout_ms: 5000

  # 短请求超时（毫秒，心跳/会话代理等）
  request_timeout_ms: 15000

  # runner 静态列表（控制面启动时同步到 runners 表）
  # 跨机器部署时，addr 填 runner 服务器的内网 IP 或主机名
  # runner 默认 HTTPS（自签证书，控制面客户端不校验）；如需 HTTP 设 RUNNER_USE_HTTPS=0
  # 修改此列表后需重启控制面生效
  addresses:
    - name: runner-1
      addr: https://192.168.1.11:21001     # 示例：runner 服务器 A
      capacity: 5
    - name: runner-2
      addr: https://192.168.1.12:21001     # 示例：runner 服务器 B
      capacity: 5

# ---- MySQL 配置（控制面多实例共享持久层） ----
# 均可被环境变量覆盖：MYSQL_HOST / MYSQL_PORT / MYSQL_USER /
#   MYSQL_PASSWORD / MYSQL_DATABASE / MYSQL_CONNECTION_LIMIT
mysql:
  host: "mysql"                    # Docker compose 内为服务名，跨机部署填内网 IP/域名
  port: 3306
  user: "dp_agt"
  password: ""                     # 建议用 MYSQL_PASSWORD 环境变量注入，不写死
  database: "dp_agt"
  connection_limit: 10

# ---- Redis 配置（控制面多实例共享协调层） ----
# 均可被环境变量覆盖：REDIS_URL / REDIS_KEY_PREFIX
redis:
  url: "redis://redis:6379"        # Docker compose 内为服务名，跨机部署填内网 IP
  key_prefix: "dp:"

# ---- 加密密钥（可选，多实例必须一致） ----
# 多实例共享同一 MySQL 时，所有实例必须用同一把密钥才能解密 prompt_config。
# 优先读环境变量 SECRETS_KEY（hex，32 字节）；未设置则回退本机 data/secrets.key。
# 建议通过环境变量注入，不写进 cfg.yml：
#   SECRETS_KEY=<64位hex>

# ---- 数据目录（可选，默认程序运行目录下的 data/） ----
# data_dir: "/app/data"
